# Copia este archivo a .env y ajusta los valores para tu entorno.
# Cambia estos puertos si alguno está ocupado en tu máquina.
WEB_PORT=3000
API_PORT=3100
DB_PORT=27017
NODE_ENV=development
MONGODB_URI=mongodb://app:app@db:27017/pizza-ya?authSource=admin
# Secreto para firmar los tokens JWT del backend (obligatorio en producción).
JWT_SECRET=secreto-demo-cambiar-en-produccion
# Credenciales del usuario del sistema (obligatorias en el backend y el frontend).
AUTH_USUARIO=operador
AUTH_CONTRASENA=pizza-ya
MONGO_INITDB_ROOT_USERNAME=app
MONGO_INITDB_ROOT_PASSWORD=app
MONGO_INITDB_DATABASE=pizza-ya
